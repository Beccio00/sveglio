root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[{*.sh,src/sveglio,*.yml}]
indent_size = 2

[tests/fixtures/*.txt]
# real dumps of /proc/bus/input/devices: keep them byte for byte
trim_trailing_whitespace = false
